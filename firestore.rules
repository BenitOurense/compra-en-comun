rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/lists/{listId} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email_verified == true;
      }
      function validList() {
        return request.resource.data.keys().hasOnly(['name','items','updatedAt'])
          && request.resource.data.keys().hasAll(['name','items','updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 70
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 500
          && request.resource.data.updatedAt is timestamp;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validList();
    }
  }
}
